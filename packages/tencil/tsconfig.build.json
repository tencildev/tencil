{
    "extends": "./tsconfig.json",
    // Declarations for the bundled workspace packages come from this one program;
    // without them in it, the dts build creates a program per file and runs out of memory.
    "include": [
        "src",
        "../bridge/src",
        "../protocol/src",
        "../provider-t3code/src",
        "../provider-claude-code/src",
        "../provider-ensemble/src"
    ],
    "exclude": ["**/*.test.ts"]
}
