{
    "name": "tencil",
    "version": "0.9.0",
    "description": "Point at any element of your running app and tell your coding agent what to fix.",
    "license": "Apache-2.0",
    "author": "Pixel Perfect Agency",
    "homepage": "https://tencil.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tencildev/tencil.git",
        "directory": "packages/tencil"
    },
    "bugs": {
        "url": "https://github.com/tencildev/tencil/issues"
    },
    "keywords": [
        "agent",
        "ai",
        "claude-code",
        "code-review",
        "comments",
        "devtools",
        "nextjs",
        "overlay",
        "react",
        "review",
        "t3",
        "t3code",
        "vite"
    ],
    "type": "module",
    "bin": {
        "tencil": "./dist/cli.mjs"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "default": "./dist/index.mjs"
        },
        "./vite": {
            "types": "./dist/vite.d.mts",
            "default": "./dist/vite.mjs"
        },
        "./react": {
            "types": "./dist/react.d.mts",
            "default": "./dist/react.mjs"
        },
        "./next": {
            "types": "./dist/next.d.mts",
            "default": "./dist/next.mjs"
        },
        "./next-loader": "./dist/next-loader.cjs",
        "./overlay.js": "./dist/overlay.global.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsdown && node scripts/copy-overlay.mjs",
        "dev": "tsdown --watch",
        "typecheck": "tsc -p .",
        "prepack": "turbo run build --filter=tencil"
    },
    "dependencies": {
        "magic-string": "^1.4.3",
        "oxc-parser": "^0.153.0",
        "picocolors": "^1.1.1",
        "ws": "^8.22.0",
        "zod": "^4.6.6"
    },
    "peerDependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.293",
        "react": ">=18",
        "vite": ">=5"
    },
    "peerDependenciesMeta": {
        "@anthropic-ai/claude-agent-sdk": {
            "optional": true
        },
        "react": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.293",
        "@tencildev/bridge": "workspace:*",
        "@tencildev/overlay": "workspace:*",
        "@tencildev/protocol": "workspace:*",
        "@tencildev/provider-claude-code": "workspace:*",
        "@tencildev/provider-ensemble": "workspace:*",
        "@tencildev/provider-t3code": "workspace:*",
        "@tencildev/testing": "workspace:*",
        "@tencildev/tsconfig": "workspace:*",
        "@types/react": "^19.3.0",
        "@types/ws": "^8.18.2",
        "react": "^19.3.0",
        "tsdown": "^0.23.0"
    }
}
