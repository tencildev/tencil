{
    "name": "@tencildev/extension",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "tsdown && node scripts/manifest.mjs",
        "dev": "tsdown --watch",
        "typecheck": "tsc -p .",
        "zip": "rm -f tencil-extension.zip && cd dist && zip -qr ../tencil-extension.zip .",
        "zip:firefox": "rm -f tencil-extension-firefox.zip && cd dist-firefox && zip -qr ../tencil-extension-firefox.zip ."
    },
    "devDependencies": {
        "@tencildev/overlay": "workspace:*",
        "@tencildev/tsconfig": "workspace:*",
        "@types/chrome": "^0.1.0",
        "tencil": "workspace:*",
        "tsdown": "^0.23.0"
    }
}
